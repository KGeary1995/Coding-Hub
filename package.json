{
  "name": "ai-coding-hub",
  "version": "1.11.2",
  "private": true,
  "description": "A local desktop workspace for Claude Code and Codex CLI sessions.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:host && npm run build:phone && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:host": "tsc -p tsconfig.electron.json",
    "build:phone": "vite build -c vite.phone.config.ts",
    "build": "npm run typecheck && vite build && npm run build:phone && npm run build:host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:pty": "npm run build:host && node scripts/run-pty-smoke.cjs",
    "test:desktop": "npm run build && node scripts/desktop-smoke.cjs",
    "rebuild:native": "npm rebuild node-pty",
    "postinstall": "install-electron && node scripts/check-native.cjs",
    "start": "npm run build && electron . --production",
    "dist:win": "npm run build && node scripts/build-windows.cjs",
    "dist:mac": "npm run build && node scripts/build-mac.cjs",
    "test:packaged": "node scripts/packaged-smoke.cjs",
    "verify:win": "node scripts/verify-windows-package.cjs",
    "test:memory": "npm run build:host && node scripts/memory-smoke.cjs",
    "test:release": "node --test scripts/release-paths.node-test.cjs",
    "test:install": "node scripts/windows-install-smoke.cjs",
    "test:design": "npm run build && node scripts/design-smoke.cjs",
    "test:profiles": "npm run build && node scripts/profiles-smoke.cjs",
    "test:workbench": "npm run build && node scripts/workbench-smoke.cjs",
    "test:enterprise": "npm run build && node scripts/enterprise-smoke.cjs",
    "dist:win:signed": "npm run build && node scripts/build-windows.cjs --signed",
    "test:productivity": "npm run build && node scripts/productivity-smoke.cjs",
    "test:models-stability": "npm run build && node scripts/models-stability-smoke.cjs",
    "test:remote": "npm run build && node scripts/remote-smoke.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@iarna/toml": "^2.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "1.5.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^44.9.3",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.4",
    "wait-on": "^8.0.1"
  },
  "author": "Coding Hub",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true
  }
}
